# coopcentric-managed vhost — rendered by coopcentric-tenant from nginx/tenant.conf.tmpl.
# Do not edit by hand: re-rendered on every deploy. Tenant: {{NAME}}
server {
    listen 80;
    server_name {{HOSTNAME}};
    root /srv/coopcentric/tenants/{{NAME}};
    access_log /var/log/nginx/{{NAME}}.access.log;

    # Static tree the TV reads (xait.xml + app). Served by nginx alone so the TV keeps
    # booting even if the Node service is down.
    # xait.xml and index.html must never be cached (they are how updates reach the set);
    # the LG libraries and the content-hashed app bundle can be cached for a long time so a
    # power cycle boots fast.
    location = /procentric/application/xait.xml {
        add_header Cache-Control "no-store";
    }
    location /procentric/application/lib/ {
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
    location ~ "^/procentric/application/app\.[0-9a-f]{8,}\.js$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    # Media library: every file name is a fresh uuid, so it can be cached for a year.
    location /procentric/application/media/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location /procentric/ {
        autoindex off;
        add_header Cache-Control "no-store";
    }

    # Tenant-scoped API — the Node server resolves the tenant from the Host header.
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # WebSocket channel to the TVs (step 2).
    location /ws/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # Admin UI (served by the Node process).
    location /admin {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / { return 302 /admin; }
}
